Class { #name : 'PharoCAToolProcessSetPriority', #superclass : 'PharoCAProcessTool', #category : 'PharoCodingAssistant-Tools-Pharo', #package : 'PharoCodingAssistant', #tag : 'Tools-Pharo' }
{ #category : 'definition' } PharoCAToolProcessSetPriority class >> toolName [ ^ #process_set_priority ]
{ #category : 'definition' } PharoCAToolProcessSetPriority class >> capability [ ^ #process ]
{ #category : 'execution' } PharoCAToolProcessSetPriority class >> executionMode [ ^ #exclusiveMutation ]
{ #category : 'definition' } PharoCAToolProcessSetPriority class >> llmDefinition [ ^ PharoCALLMToolDefinition name:'process_set_priority' description:'Changes the priority of a non-protected Pharo process within Processor lowestPriority..highestPriority.' parameters:{'type'->'object'.'properties'->{'processHandle'->{'type'->'string'} asDictionary.'priority'->{'type'->'integer'.'minimum'->1.'maximum'->100} asDictionary} asDictionary.'required'->#('processHandle' 'priority')} asDictionary ]
{ #category : 'execution' } PharoCAToolProcessSetPriority class >> execute: args [ ^ self execute:args context:PharoCAToolExecutionContext unlimited ]
{ #category : 'execution' } PharoCAToolProcessSetPriority class >> execute: args context: context [ | p priority old | p:=self processAt:(args at:'processHandle') context:context. self requireControllable:p context:context. priority:=args at:'priority'. (priority between:Processor lowestPriority and:Processor highestPriority) ifFalse:[Error signal:'Priority is outside the Processor priority range']. old:=p priority. p priority:priority. ^ {'process'->(self summaryFor:p context:context).'oldPriority'->old.'changed'->(old~=priority)} asDictionary ]
